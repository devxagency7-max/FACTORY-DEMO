VITE_API_URL=http://localhost:5000

# The ASP.NET Core SignalR Hub
VITE_SIGNALR_URL=http://localhost:5000/hubs/live-events

# The Python AI Engine (Phase 1)
VITE_AI_URL=http://localhost:8000
